# ==============================================================================
# KEIKAI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and populate variables if deploying to production.
#
# IMPORTANT:
# ALL THIRD-PARTY API KEYS ARE OPTIONAL.
# KEIKAI operates at 100% functionality locally without configuring any keys.
# ==============================================================================

# Application Environment & Server Config
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Threat Intelligence Services (Public Feeds / Optional Keys)
OPENPHISH_ENABLED=true
PHISHTANK_ENABLED=true
PHISHTANK_API_KEY=
PHISHTANK_TIMEOUT=10

# Visual Intelligence Engine (Phishpedia PyTorch & Fallback Visual Chain)
PHISHPEDIA_ENABLED=true
PHISHPEDIA_MODEL_DIR=./Phishpedia/models
PHISHPEDIA_LOGO_THRESHOLD=0.50

# Domain & Registration Intelligence (ICANN RDAP)
RDAP_ENABLED=true

# Provider Takedown & Abuse Control Plane
# Options for ABUSE_SUBMISSION_MODE: DRY_RUN (default, safe simulation) or LIVE
ABUSE_SUBMISSION_MODE=DRY_RUN
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Email Infrastructure Integrations (Task 6 Execution)
RESEND_API_KEY=
SENDGRID_API_KEY=

# viaSocket Orchestration & Webhook Automation
VIASOCKET_API_KEY=
VIASOCKET_WEBHOOK_URL=
